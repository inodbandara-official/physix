# ---------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------
# Safe to expose: these reach the browser bundle.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# SECRET. Bypasses Row Level Security. Server-only — never prefix with
# NEXT_PUBLIC_, never commit a real value. Used solely to create and
# update student login accounts.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------
# Students sign in with a username, which is expanded to
# <username>@AUTH_EMAIL_DOMAIN before it reaches Supabase Auth. It does
# not need to be a real, deliverable mail domain — students never
# receive email at it. Do not change it once accounts exist.
AUTH_EMAIL_DOMAIN="physix.local"

# ---------------------------------------------------------------------
# Database — Project Settings → Database → Connection string (URI).
# Used only by `npm run db:migrate`, never by the running app.
# ---------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres"

# ---------------------------------------------------------------------
# Seed data (`npm run db:seed`). Local development only.
# Choose your own values; there are no defaults on purpose.
# ---------------------------------------------------------------------
SEED_TEACHER_EMAIL="teacher@example.com"
SEED_TEACHER_PASSWORD=""
SEED_STUDENT_PASSWORD=""
